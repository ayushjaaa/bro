SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Custom app's API key/secret -- SHOPIFY_CLIENT_SECRET also doubles as the webhook HMAC signing
# key (see lib/webhooks/verify.ts). Not used for token exchange (see SHOPIFY_ADMIN_ACCESS_TOKEN
# below) since client_credentials grant requires the app + store to be in the same Shopify org.
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Static Admin API access token from Settings -> Apps -> Develop apps -> [app] -> API credentials.
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2026-07

# Where the storefront app runs, for the inventory webhook route to notify it which product's
# cache to invalidate. Must match a real reachable storefront (localhost in dev, real domain once
# deployed).
STOREFRONT_INTERNAL_URL=http://localhost:3000
# Shared secret for admin-panel -> storefront trusted internal calls. Must match
# INTERNAL_REVALIDATE_SECRET in storefront/.env.local exactly. Generate with:
#   openssl rand -hex 32
INTERNAL_REVALIDATE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
